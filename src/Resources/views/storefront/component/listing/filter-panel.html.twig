{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% block component_filter_panel_item_manufacturer %}
    {{ parent() }}

    {% block component_filter_panel_item_swag_product_badge %}
        {# @var badges \Shopware\Core\Framework\DataAbstractionLayer\Search\AggregationResult\Metric\EntityResult #}
        {% set badges = listing.aggregations.get('swag-product-badge') %}
        {% if badges and not badges.entities is empty %}
            {% sw_include '@Storefront/storefront/component/listing/filter/filter-multi-select.html.twig' with {
                elements: badges.entities|sort((a, b) => a.position <=> b.position),
                sidebar: sidebar,
                name: 'swag-product-badge',
                displayName: 'swagProductBadge.filterDisplayName'|trans|sw_sanitize,
                ariaLabel: 'swagProductBadge.filterAriaLabel'|trans|sw_sanitize
            } %}
        {% endif %}
    {% endblock %}
{% endblock %}
