{
    "name": "swag/product-badge",
    "description": "Own product badges with color and position, assignable per product and filterable in the storefront listing",
    "type": "shopware-platform-plugin",
    "version": "2.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "Swag\\ProductBadge\\SwagProductBadge",
        "label": {
            "de-DE": "Produkt-Badge",
            "en-GB": "Product badge"
        }
    },
    "autoload": {
        "psr-4": {
            "Swag\\ProductBadge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swag\\ProductBadge\\Tests\\": "tests/"
        }
    }
}
